NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
GEMINI_API_KEY=your_google_ai_studio_key_here
GOOGLE_MODELS=gemini-3.6-flash
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODELS=google/gemini-3.8-flash,google/gemini-3-flash-preview
MODEL_PROVIDER_ORDER=google,nvidia,openrouter
NVIDIA_REQUEST_TIMEOUT=45
MODEL_MAX_RETRIES=2
RETRY_BASE_SECONDS=0.5
LOG_LEVEL=INFO
LOG_MODEL_RAW_OUTPUT=false
PDF_RENDER_DPI=200
MAX_IMAGE_WIDTH=1800
MAX_UPLOAD_BYTES=15728640
MAX_PDF_PAGES=10
MAX_RENDERED_PIXELS=25000000
MAX_CONCURRENT_OCR=4
MAX_OCR_SECONDS=180
CORS_ALLOWED_ORIGINS=*
PORT=8000
WEB_CONCURRENCY=1
